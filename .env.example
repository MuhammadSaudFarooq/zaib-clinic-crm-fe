# =============================================================================
# Zaib Clinic — frontend environment variables
#
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows CMD / PowerShell)
#
# Every variable is optional — the app falls back to the defaults shown here.
#
# SECURITY: variables starting with VITE_ are embedded in the JavaScript bundle
# and are visible to anyone using the app. Never put secrets, passwords or
# private API keys in this file.
#
# Do NOT set NODE_ENV here — Vite manages it automatically.
# Restart `npm run dev` after changing this file.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Browser tab title
VITE_APP_TITLE=Zaib Clinic — Clinic Management

# Base URL of a future backend API.
# Unused in this frontend-only build (all data is mocked in the browser).
VITE_API_BASE_URL=

# Prefix for keys in localStorage / sessionStorage (data and login session).
# Change it to start from a clean slate without clearing the browser.
VITE_STORAGE_PREFIX=zaib-clinic

# ---------------------------------------------------------------------------
# Demo / mock data
# ---------------------------------------------------------------------------

# Show the one-click demo account buttons on the login screen (true / false)
VITE_SHOW_DEMO_ACCOUNTS=true

# Regenerate the mock data on each new calendar day so "today" always has a
# live queue (true). Set to false to keep your changes across days.
VITE_DEMO_AUTO_RESET_DAILY=true

# Days of mock history to generate (14–90).
# More days = richer reports but more localStorage used (~30 KB per day).
VITE_DEMO_HISTORY_DAYS=60

# Simulated login latency in milliseconds (0–5000)
VITE_LOGIN_DELAY_MS=650

# ---------------------------------------------------------------------------
# Dev server (read by vite.config.js only — never sent to the browser)
# ---------------------------------------------------------------------------

# Port for `npm run dev` and `npm run preview`
DEV_SERVER_PORT=5173

# Open the browser automatically when the dev server starts (true / false)
DEV_SERVER_OPEN=true
